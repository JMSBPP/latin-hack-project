{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Goal Tree Schema",
  "description": "Schema for representing hierarchical goal structures",
  "type": "object",
  "properties": {
    "main-goal": {
      "type": "string",
      "description": "Main goal description"
    },
    "sub-goals": {
      "type": "array",
      "description": "Array of sub-goals",
      "items": {
        "$ref": "#"
      }
    }
  },
  "required": ["main-goal", "sub-goals"]
}